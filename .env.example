# Copia este archivo a .env y rellena con los datos de tu proyecto Supabase.
# Settings -> API  en  https://supabase.com/dashboard
# Si dejas esto vacío, el portafolio funciona igual con el contenido de
# src/data/profile.ts y los proyectos de ejemplo de src/data/seedProjects.ts
# (sin panel de admin).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dirección pública del sitio (canonical y vista previa en LinkedIn).
# Ej.: https://elkin-moreno.tu-subdominio.workers.dev
VITE_SITE_URL=
